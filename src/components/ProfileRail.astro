---
import { siteConfig } from '../config';
---
<aside class="profile-rail">
  <div class="profile-topline">
    <span class="eyebrow">MOURN'S BLOG / 2026</span>
    <span class="status-dot" aria-label="Currently writing"></span>
  </div>

  <div class="profile-card">
    <div class="avatar-wrap">
      <img src={siteConfig.avatar} alt={`${siteConfig.name} avatar`} />
    </div>
    <p class="profile-kicker">{siteConfig.role}</p>
    <h1>{siteConfig.name}<span>{siteConfig.chineseName}</span></h1>
    <p class="profile-intro">{siteConfig.intro}</p>
  </div>

</aside>
